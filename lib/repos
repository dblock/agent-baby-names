# shellcheck shell=bash
# Names a session after a repository, for the git-clone and github-repo strategies. A strategy sources this file,
# defines list_repos to print repository names, one per line, and calls name_session with the name of its cache file.
#
# The repository is the longest listed name that the prompt mentions, else the Git checkout that holds the working
# directory. Names are lowercase words joined by hyphens. A session that already has a name keeps it. The repository
# list is cached for a day; a strategy may define list_stale to rebuild it sooner. The cache option is in lib/strategy.

# shellcheck source=lib/strategy
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/strategy"

# The repository a Git checkout belongs to: the last part of its origin, else upstream, remote URL, else its folder.
repo_name() {
  local url
  url="$(git -C "$1" config --get-regexp '^remote\.(origin|upstream)\.url$' 2>/dev/null |
    awk '$1 == "remote.origin.url" { o = $2 } $1 == "remote.upstream.url" { u = $2 } END { print o ? o : u }')"
  url="${url%/}"
  url="${url%.git}"
  if [[ -n "$url" ]]; then
    echo "${url##*[/:]}"
  else
    basename "$1"
  fi
}

# Rebuild the list sooner than after a day; strategies override this.
list_stale() {
  return 1
}

# The cached repository list, rebuilt when it is empty, older than a day, or stale. A failed rebuild keeps the old list.
repos() {
  local file="$cache_dir/$1"
  if [[ ! -s "$file" ]] || [[ -n "$(find "$file" -mmin +1440 2>/dev/null)" ]] || list_stale "$file"; then
    if list_repos >"$file.$$"; then
      mv "$file.$$" "$file"
    else
      rm -f "$file.$$"
    fi
  fi
  [[ -f "$file" ]] && cat "$file"
}

# The longest name of at least three characters on standard input that appears in the prompt as a whole word,
# ignoring case.
repo_in_prompt() {
  local words
  words=" $(tr '[:upper:]' '[:lower:]' <<<"$prompt" | tr -c 'a-z0-9._-' ' ' | tr -s ' ') "
  words="${words//. / }"
  awk -v words="$words" '
    length($0) >= 3 && length($0) > length(best) && index(words, " " tolower($0) " ") { best = $0 }
    END { print best }'
}

# The repository of the Git checkout that holds the working directory, if any.
repo_in_cwd() {
  local top
  [[ -n "$cwd" && -d "$cwd" ]] || return 0
  top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || return 0
  repo_name "$top"
}

# Prints the repository's name, given the name of the strategy's cache file, unless the session already has a name.
name_session() {
  local repo
  [[ -z "$name" ]] || return 0
  repo="$(repos "$1" | repo_in_prompt)"
  [[ -z "$repo" ]] && repo="$(repo_in_cwd)"
  slug "$repo"
}
